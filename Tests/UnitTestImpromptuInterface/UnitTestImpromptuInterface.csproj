<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0 exercises the netstandard2.0 asset, net10.0 the new one. -->
    <TargetFrameworks>net8.0;net10.0;net47</TargetFrameworks>
	  <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.7.2" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit.Console" Version="3.16.3" />
    <PackageReference Include="Moq" Version="4.*" />
    <!--
      IronPython 2.7 brings DynamicLanguageRuntime 1.3.1, which brings System.Drawing.Common
      4.7.0 - a critical advisory (GHSA-rxg9-xrhp-64gj). Nothing here draws anything; this
      pins the transitive package to a patched version so a CI build is not failing on a
      vulnerability in a package the tests never call. IronPython 3.4 would drop the
      dependency, but its overload resolution rejects the Where/Overloads forms in Linq.cs.
    -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.*" />
    <PackageReference Include="IronPython" Version="2.7.*" />



    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>






  <ItemGroup>
    <ProjectReference Include="..\..\ImpromptuInterface\ImpromptuInterface.csproj" />
    <ProjectReference Include="..\UnitTestSupportLibrary\UnitTestSupportLibrary.csproj" />
  </ItemGroup>
</Project>