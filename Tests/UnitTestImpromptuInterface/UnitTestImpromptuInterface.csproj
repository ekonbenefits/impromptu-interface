<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0 exercises the netstandard2.0 asset, net10.0 the new one. -->
    <TargetFrameworks>net8.0;net10.0;net47</TargetFrameworks>
	  <IsPackable>false</IsPackable>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.*" />
    <PackageReference Include="AnyUnit.TestingPlatform" Version="1.3.0-alpha.0.9" />
    <PackageReference Include="AnyUnit.Style.Nunit" Version="1.3.0-alpha.0.9" />
    <PackageReference Include="AnyUnit.Constraints" Version="1.3.0-alpha.0.9" />
    <PackageReference Include="Moq" Version="4.*" />
    <!-- 3.x, not 2.7: that line brings DynamicLanguageRuntime 1.3.1 and with it
         System.Drawing.Common 4.7.0, a critical advisory (GHSA-rxg9-xrhp-64gj). -->
    <PackageReference Include="IronPython" Version="3.4.*" />



    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="IronPython" Version="2.7.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ImpromptuInterface\ImpromptuInterface.csproj" />
    <ProjectReference Include="..\UnitTestSupportLibrary\UnitTestSupportLibrary.csproj" />
  </ItemGroup>
</Project>
